<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Design.PreviewWith>
        <StackPanel Margin="20" Spacing="20">
            <ButtonSpinner BorderThickness="1" Height="30">
                <TextBlock
                    HorizontalAlignment="Center"
                    Text="A.S.I.A"
                    VerticalAlignment="Center" />
            </ButtonSpinner>
            <ButtonSpinner
                BorderThickness="1"
                Classes="vertical"
                Height="30">
                <TextBlock
                    HorizontalAlignment="Center"
                    Text="A.S.I.A"
                    VerticalAlignment="Center" />
            </ButtonSpinner>
            <ButtonSpinner
                BorderThickness="1"
                ButtonSpinnerLocation="Left"
                Height="30">
                <TextBlock
                    HorizontalAlignment="Center"
                    Text="A.S.I.A"
                    VerticalAlignment="Center" />
            </ButtonSpinner>
            <ButtonSpinner
                BorderThickness="1"
                Height="30"
                Theme="{StaticResource SplitButtonSpinner}">
                <TextBlock
                    HorizontalAlignment="Center"
                    Text="A.S.I.A"
                    VerticalAlignment="Center" />
            </ButtonSpinner>
            <ButtonSpinner
                BorderThickness="1"
                ButtonSpinnerLocation="Left"
                Height="30"
                Theme="{StaticResource SplitButtonSpinner}">
                <TextBlock
                    HorizontalAlignment="Center"
                    Text="A.S.I.A"
                    VerticalAlignment="Center" />
            </ButtonSpinner>
        </StackPanel>
    </Design.PreviewWith>

    <ControlTheme TargetType="RepeatButton" x:Key="ButtonSpinnerRepeatButtonTheme">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                    Name="PART_ContentPresenter"
                    Padding="{TemplateBinding Padding}"
                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlPointeroverBackground}" />
        </Style>

        <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlPressedBackground}" />
        </Style>

        <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlDisabledBackground}" />
        </Style>
    </ControlTheme>

    <ControlTheme TargetType="ButtonSpinner" x:Key="{x:Type ButtonSpinner}">
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource OvoCornerRadius}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinWidth" Value="300" />
        <Setter Property="Template">
            <ControlTemplate TargetType="ButtonSpinner">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <Border
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Grid.Column="1">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            Name="PART_ContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <Border
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1"
                        ClipToBounds="True"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Grid.Column="2"
                        IsVisible="{TemplateBinding ShowButtonSpinner}"
                        Margin="4,0,0,0"
                        MinWidth="16"
                        Name="ButtonGroup"
                        UseLayoutRounding="False">
                        <StackPanel Name="PART_Grid" Orientation="Horizontal">
                            <RepeatButton
                                CornerRadius="9,0,0,9"
                                Name="PART_IncreaseButton"
                                Padding="6,0,1,0"
                                Theme="{StaticResource ButtonSpinnerRepeatButtonTheme}">
                                <TextBlock
                                    FontFamily="{DynamicResource OvoIconFontFamily}"
                                    FontSize="18"
                                    FontWeight="Light"
                                    Foreground="{DynamicResource InnerForegroundBrush}"
                                    HorizontalAlignment="Center"
                                    Name="PART_IncreaseButtonTextBlock"
                                    Text="&#xe645;"
                                    VerticalAlignment="Center" />
                            </RepeatButton>

                            <RepeatButton
                                CornerRadius="0,9,9,0"
                                Name="PART_DecreaseButton"
                                Padding="1,0,6,0"
                                Theme="{StaticResource ButtonSpinnerRepeatButtonTheme}">
                                <TextBlock
                                    FontFamily="{DynamicResource OvoIconFontFamily}"
                                    FontSize="18"
                                    FontWeight="Light"
                                    Foreground="{DynamicResource InnerForegroundBrush}"
                                    HorizontalAlignment="Center"
                                    Name="PART_DecreaseButtonTextBlock"
                                    Text="&#xe623;"
                                    VerticalAlignment="Center" />
                            </RepeatButton>

                        </StackPanel>
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^.vertical">
            <Style Selector="^ /template/ StackPanel#PART_Grid">
                <Setter Property="Orientation" Value="Vertical" />
            </Style>
            <Style Selector="^ /template/ TextBlock#PART_IncreaseButtonTextBlock">
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style Selector="^ /template/ TextBlock#PART_DecreaseButtonTextBlock">
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style Selector="^ /template/ RepeatButton#PART_IncreaseButton">
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="9,9,0,0" />
            </Style>
            <Style Selector="^ /template/ RepeatButton#PART_DecreaseButton">
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="0,0,9,9" />
            </Style>
        </Style>
        <Style Selector="^:left /template/ Border#ButtonGroup">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Margin" Value="0 0 4 0" />
        </Style>

    </ControlTheme>

    <ControlTheme TargetType="ButtonSpinner" x:Key="SplitButtonSpinner">
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource OvoCornerRadius}" />
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="Template">
            <ControlTemplate TargetType="ButtonSpinner">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <RepeatButton
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource OvoCornerRadius}"
                        Grid.Column="0"
                        IsVisible="{TemplateBinding ShowButtonSpinner}"
                        Name="PART_DecreaseButton"
                        Padding="{DynamicResource SplitButtonSpinnerButtonPadding}"
                        Theme="{StaticResource ButtonSpinnerRepeatButtonTheme}"
                        VerticalAlignment="Stretch"
                        Width="30">
                        <TextBlock
                            FontFamily="{DynamicResource OvoIconFontFamily}"
                            FontSize="18"
                            FontWeight="Light"
                            Foreground="{DynamicResource InnerForegroundBrush}"
                            HorizontalAlignment="Center"
                            Name="PART_IncreaseButtonTextBlock"
                            Text="&#xe645;"
                            VerticalAlignment="Center" />
                    </RepeatButton>
                    <Border
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Grid.Column="1"
                        Margin="4,0">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            Name="PART_ContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <RepeatButton
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource OvoCornerRadius}"
                        Grid.Column="2"
                        IsVisible="{TemplateBinding ShowButtonSpinner}"
                        Name="PART_IncreaseButton"
                        Padding="{DynamicResource SplitButtonSpinnerButtonPadding}"
                        Theme="{StaticResource ButtonSpinnerRepeatButtonTheme}"
                        VerticalAlignment="Stretch"
                        Width="30">
                        <TextBlock
                            FontFamily="{DynamicResource OvoIconFontFamily}"
                            FontSize="18"
                            FontWeight="Light"
                            Foreground="{DynamicResource InnerForegroundBrush}"
                            HorizontalAlignment="Center"
                            Name="PART_DecreaseButtonTextBlock"
                            Text="&#xe623;"
                            VerticalAlignment="Center" />
                    </RepeatButton>
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:left /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Grid.Column" Value="2" />
        </Style>
        <Style Selector="^:left /template/ RepeatButton#PART_IncreaseButton">
            <Setter Property="Grid.Column" Value="0" />
        </Style>
    </ControlTheme>
</ResourceDictionary>